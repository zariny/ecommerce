######################################
# cp ./.env.example ./.env
######################################


# --- DJANGO ---
SECRET_KEY=change-me-to-a-random-secret-key
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True # False
LOGGING_QUERIES= True # False 
ALLOWED_HOSTS=* # localhost, 127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True


# --- DATABASE ---
DATABASE_ENGINE=django.db.backends.sqlite3 # django.db.backends.postgresql
DATABASE_NAME=Database.sqlite3 # ecommerce
DATABASE_USER= # ecommerce 
DATABASE_PASSWORD= # openssl rand -hex 32
DATABASE_HOST= # db
DATABASE_PORT= # 5432


# --- CACHE ---
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache # django_redis.cache.RedisCache
CACHE_LOCATION= # redis://127.0.0.1:6379/1
CACHE_TIMEOUT=300
